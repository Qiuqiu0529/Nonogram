    characterSetSelectionMode: 7
    characterSequence: " 125NT_etwx\xD7\u201C\u201D\u2026\u25A1\u3002\u4E00\u4E0A\u4E0B\u4E24\u4E2D\u4E50\u4E5F\u4EE3\u4F59\u5173\u5176\u51FA\u5206\u5207\u5217\u5230\u5269\u5361\u53EF\u5404\u5427\u56DE\u56F0\u56FE\u586B\u5B57\u5B83\u5B8C\u5C11\u5DF1\u5DF2\u5F0F\u628A\u6548\u6570\u65F6\u662F\u672C\u6765\u6807\u683C\u6848\u6A21\u6EE1\u70B9\u73A9\u753B\u7684\u770B\u7740\u793A\u7A7A\u7B14\u7B2C\u7EC4\u7ECF\u7ED9\u7EED\u7F6E\u81EA\u81F3\u85CF\u884C\u8868\u8981\u8BB0\u8BBE\u8BD5\u8C03\u8D77\u8DDF\u8FD9\u8FDE\u9047\u91CD\u95F4\u96BE\u97F3\uFF01\uFF0C\u754C\u9762\u83DC\u5355\u5173\u5361
      void SetLesson(Lesson next)\r\n        {\r\n            lesson = next;\r\n           
      measuredScreenWidth = -1f;\r\n            switch (next)\r\n            {\r\n               
      case Lesson.FirstFill: lessonText.text = \"\u8DDF\u7740\u6570\u5B57\uFF0C\u628A\u85CF\u8D77\u6765\u7684\u56FE\u6848\u753B\u51FA\u6765\u5427\uFF01\\n\u6570\u5B57
      5 \u8868\u793A\u8FD9\u4E00\u884C\u8981\u8FDE\u7EED\u586B\u6EE1 5 \u683C\uFF0C\u8BD5\u8BD5\u770B\uFF01\";
      break;\r\n                case Lesson.SecondFill: lessonText.text = \"\u8FD9\u4E00\u884C\u4E5F\u662F
      5\uFF0C\u628A\u5B83\u586B\u6EE1\u5427\uFF01\"; break;\r\n                case
      Lesson.LeftColumn: lessonText.text = marking\r\n                    ? \"\u7ED9\u7B2C\u4E00\u5217\u5269\u4E0B\u7684\u7A7A\u683C\u6807\u4E0A
      \xD7\u3002\"\r\n                    : \"\u7B2C\u4E00\u5217\u7684 2 \u4EE3\u8868\u8FDE\u7EED\u586B
      2 \u683C\u3002\u5DF2\u7ECF\u586B\u6EE1\uFF0C\u70B9 \xD7 \u6807\u8BB0\u5176\u4F59\u7A7A\u683C\u3002\";
      break;\r\n                case Lesson.RightColumn: lessonText.text = \"\u7B2C
      5 \u5217\u4E5F\u662F 2\u3002\u81EA\u5DF1\u628A\u5269\u4E0B\u7684\u7A7A\u683C\u6807\u4E0A
      \xD7 \u5427\uFF01\"; break;\r\n                case Lesson.SplitRow: lessonText.text
      = marking\r\n                    ? \"\u5207\u56DE\u753B\u7B14\uFF0C\u770B\u770B\u7B2C\u4E00\u884C\u7684
      1 1\u3002\"\r\n                    : \"1 1 \u8868\u793A\u4E24\u7EC4\u5404 1
      \u683C\uFF0C\u4E2D\u95F4\u81F3\u5C11\u7A7A 1 \u683C\u3002\u8BD5\u7740\u586B\u5B8C\u7B2C\u4E00\u884C\u3002\";
      break;\r\n                case Lesson.Hint: lessonText.text = \"\u9047\u5230\u56F0\u96BE\u65F6\uFF0C\u53EF\u4EE5\u4F7F\u7528\u201C\u63D0\u793A\u201D\u3002\";
      break;\r\n                case Lesson.Fish: lessonText.text = \"\u5C0F\u9C7C\u5E72\u4EE3\u8868\u5269\u4F59\u5C1D\u8BD5\u6B21\u6570\uFF0C\u5C0F\u5FC3\u63A8\u7406\u5427\uFF01\";
      break;\r\n            }\r\n            UpdateTutorialLayout();\r\n           
      RefreshHintButton(TutorialAllowsHint);"
